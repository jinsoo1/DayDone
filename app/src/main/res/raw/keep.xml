<?xml version="1.0" encoding="utf-8"?>
<!--
  리소스 축소(shrinkResources) 방어.
  Glance 는 런타임에 레이아웃을 골라 쓰기 때문에 축소기가 참조를 놓치면
  릴리즈에서 위젯이 빈 화면으로 뜬다. 위젯 관련 리소스는 명시적으로 지킨다.
-->
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@layout/glance_*,@xml/daydone_widget_info,@drawable/glance_*"
    tools:shrinkMode="safe" />
